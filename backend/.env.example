# ---------------------------------------------------------------
# Dialogue with Future Entrepreneurs — backend configuration
# Copy to .env and edit. Never commit the real .env.
# ---------------------------------------------------------------

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=dialogue_futures

# Admin login (single account, used by /admin)
ADMIN_USERNAME=admin
# Either a plain password (dev) ...
ADMIN_PASSWORD=change-this-password
# ... or a bcrypt hash (production; takes priority when set)
# ADMIN_PASSWORD_HASH=$2b$12$....

# JWT signing secret — generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=480


# Comma-separated list of allowed browser origins for the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public site URL (used in exported file names / links only)
PUBLIC_BASE_URL=http://localhost:5173

# Dev-only: run against an in-memory Mongo stand-in when no server is available.
# Leave unset/0 in production.
USE_MOCK_DB=0
